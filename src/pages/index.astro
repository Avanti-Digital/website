---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Work from '../components/Work.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import FinalCta from '../components/FinalCta.astro';
import SiteFooter from '../components/SiteFooter.astro';
import content from '../content/site.json';
---

<BaseLayout meta={content.meta} company={content.company}>
	<SiteHeader company={content.company} navigation={content.navigation} cta={content.headerCta} />
	<main id="main-content">
		<Hero content={content.hero} />
		<Services content={content.services} />
		<Work content={content.work} />
		<Process content={content.process} />
		<About content={content.about} />
		<FinalCta content={content.finalCta} email={content.company.email} />
	</main>
	<SiteFooter company={content.company} />
</BaseLayout>
