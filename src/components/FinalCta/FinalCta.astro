---
import content from './content.json';
import './FinalCta.css';
---

<section class="final-cta" id="contact">
	<div class="container final-cta-inner">
		<p class="eyebrow eyebrow-light">{content.eyebrow}</p>
		<h2>{content.title}</h2>
		<p>{content.description}</p>
		<form class="contact-form" action={content.form.endpoint} method="POST">
			<div class="form-field">
				<label for="contact-name">{content.form.fields.name.label}</label>
				<input
					id="contact-name"
					name="name"
					type="text"
					autocomplete="name"
					placeholder={content.form.fields.name.placeholder}
					required
				/>
			</div>
			<div class="form-field">
				<label for="contact-email">{content.form.fields.email.label}</label>
				<input
					id="contact-email"
					name="email"
					type="email"
					autocomplete="email"
					placeholder={content.form.fields.email.placeholder}
					required
				/>
			</div>
			<div class="form-field form-field-note">
				<label for="contact-note">{content.form.fields.note.label}</label>
				<textarea
					id="contact-note"
					name="note"
					rows="6"
					placeholder={content.form.fields.note.placeholder}
					required
				></textarea>
			</div>
			<button class="button button-light contact-submit" type="submit">
				{content.form.submitLabel}<span aria-hidden="true">↗</span>
			</button>
		</form>
	</div>
</section>
