---
import brandMark from '../../assets/avanti-favicon-color.svg';
import content from './content.json';
import './Hero.css';
---

<section class="hero" aria-labelledby="hero-title">
	<div class="container hero-grid">
		<div class="hero-copy">
			<h1 id="hero-title">
				{content.title}
				<span>{content.titleAccent}</span>
			</h1>
			<p class="hero-description">{content.description}</p>
			<div class="button-group">
				<a class="button button-primary" href={content.primaryCta.href}>
					{content.primaryCta.label}<span aria-hidden="true">↗</span>
				</a>
				<a class="text-link" href={content.secondaryCta.href}>
					{content.secondaryCta.label}<span aria-hidden="true">↓</span>
				</a>
			</div>
		</div>

		<div class="hero-preview-wrap" aria-label="Example of a clean small business website">
			<div class="preview-kicker">
				<p class="preview-label">{content.preview.label}</p>
				<img class="preview-brand-mark" src={brandMark.src} alt="" aria-hidden="true" />
			</div>
			<div class="browser-card">
				<div class="browser-bar" aria-hidden="true">
					<span></span><span></span><span></span>
				</div>
				<div class="preview-site">
					<div class="preview-nav">
						<strong>{content.preview.business}</strong>
						<span>Services&nbsp;&nbsp; About&nbsp;&nbsp; Contact</span>
					</div>
					<div class="preview-body">
						<p>LOCAL · RELIABLE · EXPERIENCED</p>
						<h2>{content.preview.title}</h2>
						<span class="preview-button">{content.preview.button} ↗</span>
					</div>
					<div class="preview-details">
						{content.preview.details.map((detail) => <span>{detail}</span>)}
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="container proof-row" aria-label="What every website includes">
		{content.proof.map((item) => <span>{item}</span>)}
	</div>
</section>
