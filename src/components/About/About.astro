---
import content from './content.json';
import './About.css';
---

<section class="section about-section" id="about">
	<div class="container about-grid">
		<div class="about-copy">
			<p class="eyebrow">{content.eyebrow}</p>
			<h2>{content.title}</h2>
			<p>{content.description}</p>
			<aside class="about-research" aria-label="Research about trusted sources for local businesses">
				<strong>{content.research.number}</strong>
				<p>
					{content.research.description}<sup class="citation-marker"><a
						id="citation-brightlocal"
						href="#source-brightlocal"
						aria-label="View source 3 for the BrightLocal statistic"
					>[3]</a></sup>
				</p>
			</aside>
		</div>
		<div class="audience-card">
			<p class="audience-title">{content.audienceTitle}</p>
			<ul>
				{
					content.audiences.map((audience) => (
						<li>
							<span>{audience}</span>
							<span aria-hidden="true">↗</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
